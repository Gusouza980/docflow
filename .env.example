APP_NAME=Docflow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Filas: use "database" ou "redis" em staging/produção.
# Em produção, rode um worker persistente:
#   php artisan queue:work --tries=3 --sleep=1
# Nunca use "sync" em produção.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail (desenvolvimento com Sail + Mailpit)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@docflow.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Produção / staging: SMTP real (nunca use MAIL_MAILER=log) ---
# Resend (SMTP):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_xxxxxxxx
# MAIL_SCHEME=tls
#
# Postmark (SMTP):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.postmarkapp.com
# MAIL_PORT=587
# MAIL_USERNAME=seu-server-token
# MAIL_PASSWORD=seu-server-token
# MAIL_SCHEME=tls
#
# Postmark (driver nativo):
# MAIL_MAILER=postmark
# POSTMARK_TOKEN=seu-server-token
#
# Resend (driver nativo):
# MAIL_MAILER=resend
# RESEND_KEY=re_xxxxxxxx

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700

MEILISEARCH_NO_ANALYTICS=false

# Billing SaaS (Sprint 16)
DOCFLOW_BILLING_DRIVER=manual
DOCFLOW_BILLING_INVOICE_DUE_DAYS=7
DOCFLOW_BILLING_WEBHOOK_SECRET=
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_SECRET=

# Validação de deploy (mail + fila):
# php artisan docflow:health
